# ------------------------------------------------------------
# Build output
# ------------------------------------------------------------
build/
build-*/
cmake-build-*/
out/
.cache/
compile_commands.json
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
Testing/

# ------------------------------------------------------------
# Compiled objects and binaries
# ------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app

# Exercise binaries built by hand with nvcc next to the source.
# The CMake build puts everything under build/bin instead.
**/exercises/*/main
**/exercises/*/solution
**/projects/*/main
**/projects/*/solution

# ------------------------------------------------------------
# CUDA intermediates
# ------------------------------------------------------------
*.cubin
*.fatbin
*.fatbin.c
*.ptx
*.sass
*.gpu
*.i
*.ii
*.cudafe1.*
*.module_id

# ------------------------------------------------------------
# Profiler output
# ------------------------------------------------------------
*.nsys-rep
*.ncu-rep
*.qdrep
*.qdstrm
*.sqlite
profile_*.txt

# ------------------------------------------------------------
# Images generated by the exercises
# ------------------------------------------------------------
# Files that are meant to be committed live under assets/ and are
# re-included by the negated patterns below.
*.ppm
*.pgm
!**/assets/*.ppm
!**/assets/*.pgm

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/

# ------------------------------------------------------------
# Editors and OS
# ------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
